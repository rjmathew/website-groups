{
  "manifest_version": 3,
  "name": "Website Groups",
  "description": "Open or close a whole group of websites in one click. Make groups for your morning reading, work tools or distractions.",
  "version": "1.0.0",
  "permissions": ["tabs", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Website Groups",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
